# Training outputs
training/outputs/vedrishi_unsloth_format.jsonl
training/outputs/vedrishi_train.jsonl
training/outputs/vedrishi_val.jsonl

# Logs
*.log

# Temp files
*.tmp
*.temp

# MemePalace submodule (keep reference, ignore contents)
vendor/mempalace/*
!vendor/mempalace/.gitkeep
